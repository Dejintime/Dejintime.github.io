{
	"name": "Jekyll (Ruby 3.2)",
	"build": {
		"dockerfile": "../Dockerfile",
		"context": ".."
	},
	"workspaceFolder": "/srv/jekyll",
	"forwardPorts": [4000],
	"postCreateCommand": "bundle config set --local path vendor/bundle && bundle install"
